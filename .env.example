# ============ ZELVO ENVIRONMENT ============
# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-only, for admin stats & webhooks

# AI (server-only — never exposed to the browser)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=                   # aistudio.google.com/apikey — powers Image Studio (gemini-3-pro-image)

# Paystack (dashboard.paystack.com -> Settings -> API Keys & Webhooks)
PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=   # optional for client-side widgets
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=           # Dashboard -> Settings -> API Keys & Webhooks -> Secret Key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_GOOGLE_OAUTH=false
NEXT_PUBLIC_ENABLE_AZURE_OAUTH=false
ADMIN_EMAILS=you@yourdomain.com

# Desktop downloads (public URLs used by /downloads)
# Source mode:
# - github (default): always use GitHub release assets
# - supabase: always use Supabase storage URL below
# - auto: use Supabase if base URL is set, otherwise GitHub
NEXT_PUBLIC_DESKTOP_DOWNLOAD_SOURCE=github
# Supabase example:
# NEXT_PUBLIC_DESKTOP_DOWNLOAD_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/desktop-downloads
# Files should be uploaded under <base>/<release-tag>/<asset-file>
NEXT_PUBLIC_DESKTOP_DOWNLOAD_BASE_URL=
NEXT_PUBLIC_DESKTOP_RELEASE_TAG=desktop-v0.1.1
NEXT_PUBLIC_DESKTOP_RELEASE_VERSION=0.1.1
